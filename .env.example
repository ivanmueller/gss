# Key names only, never values. Staging and production secrets live in the
# Cloudflare, Supabase and GitHub secret stores, not in files.
#
# Web app build (Vite; public values). For local work point them at a local
# Supabase (`supabase status -o env`: API_URL, ANON_KEY).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
#
# Worker overrides for `wrangler dev --env staging` go in apps/api/.dev.vars.staging
# (gitignored), the same two values without the VITE_ prefix plus the database:
#   SUPABASE_URL=
#   SUPABASE_PUBLISHABLE_KEY=
#   DATABASE_URL=          # app_api login, e.g. local postgresql://app_api:...@127.0.0.1:54322/postgres
#
# API database tests (`pnpm --filter @grain/api test:db`), local databases only:
API_TEST_ADMIN_DATABASE_URL=
API_TEST_DATABASE_URL=
#
# Browser tests (tests/e2e) against a local Supabase only:
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_DATABASE_URL=
