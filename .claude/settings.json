{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node .claude/skills/codex-review/run-review.js:*)",
      "Bash(node scripts/review-gate.js:*)",
      "Bash(node --test scripts/:*)",
      "Bash(gh pr merge * --auto --squash)",
      "Bash(gh pr ready:*)"
    ],
    "deny": [
      "Bash(gh pr merge *--admin*)",
      "Bash(gh pr merge * -A*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr edit * --add-label*)",
      "Bash(gh pr create *--label*)",
      "Bash(gh label:*)",
      "Bash(gh api *labels*)",
      "Bash(gh workflow run:*)",
      "Bash(gh workflow enable:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api */merge*)",
      "Bash(gh api *environments*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push *:main)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(pnpm --filter @grain/api exec wrangler deploy:*)",
      "Bash(pnpm exec wrangler deploy:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset --linked:*)",
      "Bash(codex *--dangerously-bypass-approvals-and-sandbox*)",
      "PowerShell(gh pr merge *--admin*)",
      "PowerShell(gh api *labels*)",
      "PowerShell(gh pr review:*)",
      "PowerShell(gh workflow run:*)",
      "PowerShell(gh secret:*)",
      "PowerShell(gh api *protection*)",
      "PowerShell(gh api */merge*)",
      "PowerShell(git push * main)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *--force*)",
      "PowerShell(wrangler deploy:*)",
      "PowerShell(npx wrangler deploy:*)",
      "PowerShell(pnpm --filter @grain/api exec wrangler deploy:*)",
      "PowerShell(supabase db push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-merge.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
