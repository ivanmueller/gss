{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grain-trading-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // postgres.js (the database driver) needs Node.js APIs such as Buffer.
  "compatibility_flags": ["nodejs_compat"],
  // CI runs `wrangler deploy --env staging`, which publishes grain-trading-api-staging
  // on workers.dev. The top-level config is for local `wrangler dev` of the API alone;
  // production gets its own environment and an approval-gated workflow later.
  "env": {
    "staging": {
      // Public values: the project URL and publishable key are meant to be known.
      // Access is enforced by Supabase Auth and by the API's own checks.
      // `wrangler dev --env staging` reads overrides from .dev.vars.staging (gitignored).
      "vars": {
        "SUPABASE_URL": "https://nfwizbcpjpqxdoojfbdr.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_4gRcidcCPr7dsdATHL57nQ_QNY0SNAc",
      },
      // The same Worker serves the web app built by `pnpm build`, so the browser and
      // API share one origin. /api/* always reaches the Worker; any other unknown
      // path returns the app's index.html.
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      // Cloudflare Hyperdrive in front of Supabase: it verifies Supabase's certificate,
      // which the Workers runtime cannot (docs/DECISIONS.md). Created by the "Set up
      // Hyperdrive (staging)" workflow. `wrangler dev` reads the local database from
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "bbc915879c6848abaa08605ff7d7825c" }],
      // Keeps Workers Logs on across deploys (the API logs secret-free failure reasons).
      "observability": {
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true,
        },
        "traces": { "enabled": false },
      },
    },
  },
}
